.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: var(--color-bg); }
.state-panel, .empty-panel, .error-panel { padding: 190rpx 30rpx; color: #8d867e; text-align: center; }
.empty-panel, .error-panel { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-title { color: #3f3a35; font-size: 32rpx; font-weight: 700; }
.empty-description { font-size: 24rpx; }
.retry-button, .load-more { padding: 16rpx 30rpx; border-radius: 30rpx; background: #fff0ea; color: #c74e36; font-size: 24rpx; }
.order-list { display: flex; flex-direction: column; gap: 22rpx; }
.order-card, .legacy-card { padding: 26rpx; border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-soft); }
.order-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; margin-bottom: 20rpx; }
.order-heading-copy { flex: 1; min-width: 0; }
.order-display-title, .order-meta { display: block; overflow-wrap: anywhere; }
.order-display-title { color: var(--color-text-primary); font-size: 29rpx; line-height: 1.35; font-weight: 800; }
.order-meta { margin-top: 7rpx; color: var(--color-text-muted); font-size: 20rpx; line-height: 1.5; }
.status-tag { flex-shrink: 0; padding: 7rpx 16rpx; border-radius: 24rpx; font-size: 22rpx; }
.status-pending { background: #fff5df; color: #a86d13; }
.status-confirmed { background: #eaf4ff; color: #3178b7; }
.status-preparing { background: #fff0e7; color: #c35c2f; }
.status-completed { background: #eaf7ee; color: #368250; }
.status-cancelled { background: #f2f1ef; color: #817b74; }
.order-items { padding: 17rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.order-item { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; padding: 8rpx 0; }
.item-main { min-width: 0; flex: 1; }
.item-name, .item-summary { display: block; overflow-wrap: anywhere; }
.item-name { color: #4a4540; font-size: 25rpx; }
.item-summary { margin-top: 5rpx; color: #918a83; font-size: 21rpx; line-height: 1.5; }
.item-price { flex-shrink: 0; color: var(--color-price); font-size: 23rpx; }
.order-note { margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #f8f5f1; color: #706961; font-size: 23rpx; line-height: 1.55; }
.order-footer { display: flex; justify-content: space-between; align-items: flex-end; gap: 20rpx; margin-top: 19rpx; }
.order-count, .order-total, .unpriced-tip { display: block; }
.order-count { color: #8a837b; font-size: 21rpx; }
.order-total { margin-top: 5rpx; color: var(--color-price); font-size: 27rpx; font-weight: 700; }
.unpriced-tip { margin-top: 5rpx; color: #9a6c36; font-size: 20rpx; }
.order-actions { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 16rpx; }
.cancel-button { padding: 10rpx 16rpx; border-radius: 20rpx; background: #fff1ee; color: #bf5547; font-size: 21rpx; }
.detail-link { color: #9a6c36; font-size: 22rpx; }
.load-more { align-self: center; margin: 8rpx auto 0; text-align: center; }
.legacy-section { margin-top: 34rpx; }
.legacy-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15rpx; color: #59534d; font-size: 26rpx; font-weight: 700; }
.legacy-tip { color: #a19a92; font-size: 20rpx; font-weight: 400; }
.legacy-card { margin-bottom: 16rpx; opacity: 0.78; }
.legacy-item { display: block; padding: 5rpx 0; color: #716b65; font-size: 23rpx; }
