<view class="tab-bar brand-theme">
  <view class="tab-bar-content">
    <view 
      wx:for="{{list}}" 
      wx:key="key"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="icon-wrapper">
        <view class="tab-symbol tab-symbol-{{item.icon}}" aria-hidden="true">
          <view class="symbol-top" /><view class="symbol-body" /><view class="symbol-line" />
        </view>
        <text wx:if="{{item.key === 'profile' && openOrderBadge}}" class="tab-badge">{{openOrderBadge}}</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
  <view class="tab-bar-safe"></view>
</view>
