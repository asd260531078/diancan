page { background: #f5f3ef; color: #312e2a; }
.meal-page { min-height: 100vh; padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.meal-page.has-result-actions { padding-bottom: calc(270rpx + env(safe-area-inset-bottom)); }
.hero-card { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 24rpx; padding: 34rpx 30rpx; border-radius: 26rpx; background: linear-gradient(135deg, #fff2e8, #ffe2d5); box-shadow: 0 8rpx 24rpx rgba(120, 64, 42, 0.08); }
.hero-eyebrow { color: #b76548; font-size: 22rpx; letter-spacing: 3rpx; }
.hero-title { color: #2f2925; font-size: 46rpx; font-weight: 800; }
.hero-subtitle { color: #766b63; font-size: 25rpx; }
.state-panel { padding: 180rpx 30rpx; color: #8f8881; text-align: center; }
.empty-panel { display: flex; flex-direction: column; gap: 16rpx; }
.empty-title { color: #45403b; font-size: 31rpx; font-weight: 700; }
.empty-description { font-size: 24rpx; line-height: 1.6; }
.error-panel { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.retry-button { min-width: 220rpx; margin: 10rpx 0 0; border-radius: 16rpx; background: #ed684b; color: #fff; font-size: 25rpx; line-height: 76rpx; }
.retry-button::after { border: 0; }
.choice-panel { padding: 30rpx 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(42, 34, 28, 0.05); }
.step-eyebrow { display: block; margin-bottom: 8rpx; color: #bb674c; font-size: 22rpx; }
.choice-title { display: block; color: #332f2b; font-size: 36rpx; font-weight: 750; }
.choice-description { display: block; margin-top: 10rpx; color: #8a827a; font-size: 23rpx; }
.category-grid { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 28rpx; }
.category-option { width: calc(50% - 9rpx); min-height: 126rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; padding: 18rpx; box-sizing: border-box; border: 2rpx solid #eee7df; border-radius: 16rpx; background: #fcfaf7; color: #4a433d; }
.category-option:active { border-color: #e06a4e; background: #fff2eb; }
.category-option.selected { border-color: #df6045; background: #fff0e8; color: #a84430; box-shadow: inset 0 0 0 1rpx rgba(223, 96, 69, 0.12); }
.category-option-main { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.selected-mark { display: flex; width: 34rpx; height: 34rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 8rpx; background: #df6045; color: #fff; font-size: 23rpx; font-weight: 800; line-height: 34rpx; }
.category-icon { width: 42rpx; height: 42rpx; flex-shrink: 0; }
.category-icon-text { max-width: 100rpx; overflow: hidden; color: #b45e45; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.category-name { min-width: 0; font-size: 28rpx; font-weight: 650; }
.category-count-control { display: flex; align-items: center; justify-content: center; gap: 14rpx; width: 100%; }
.category-count-button { width: 80rpx; height: 80rpx; min-width: 80rpx; margin: 0; padding: 0; border-radius: 14rpx; background: #f8dfd2; color: #a84430; font-size: 35rpx; font-weight: 700; line-height: 80rpx; }
.category-count-button[disabled] { background: #f4eae4; color: #c4afa3; }
.category-count-button::after { border: 0; }
.category-count-value { min-width: 62rpx; color: #94442f; font-size: 24rpx; font-weight: 700; text-align: center; }
.food-next-area { margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid #eee7df; }
.selection-count { display: block; margin-bottom: 14rpx; color: #817870; font-size: 23rpx; text-align: center; }
.food-next-button { width: 100%; margin: 0; border-radius: 16rpx; background: #e25f43; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 84rpx; }
.food-next-button[disabled] { background: #e4dfda; color: #a49c95; }
.food-next-button::after { border: 0; }
.back-button { width: auto; margin: 0 0 24rpx; padding: 0; background: transparent; color: #7b726a; font-size: 24rpx; line-height: 1.5; text-align: left; }
.back-button::after { border: 0; }
.question-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 34rpx; }
.question-button { width: 100%; margin: 0; border-radius: 16rpx; background: #f3efea; color: #514943; font-size: 28rpx; font-weight: 650; line-height: 88rpx; }
.question-button.primary { background: #ed684b; color: #fff; }
.question-button::after { border: 0; }
.skip-drink-button { margin: 24rpx 0 0; border-radius: 16rpx; background: #f3efea; color: #625a53; font-size: 25rpx; line-height: 76rpx; }
.skip-drink-button::after { border: 0; }
.selection-summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12rpx; margin-bottom: 20rpx; color: #a2513c; font-size: 24rpx; text-align: center; }
.summary-dot { color: #cfc5bc; }
.result-heading { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 20rpx; }
.result-title { color: #332f2b; font-size: 34rpx; font-weight: 750; }
.result-count { color: #a2513c; font-size: 24rpx; font-weight: 650; }
.result-subtitle { color: #898078; font-size: 22rpx; }
.meal-list { display: flex; flex-direction: column; gap: 20rpx; }
.meal-card { display: flex; gap: 22rpx; padding: 22rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(42, 34, 28, 0.05); }
.meal-cover { width: 180rpx; height: 180rpx; flex-shrink: 0; border-radius: 18rpx; background: #eeeae4; }
.meal-main { min-width: 0; flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 14rpx; }
.meal-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.role-label { padding: 6rpx 12rpx; border-radius: 8rpx; background: #fff0e7; color: #b6533c; font-size: 21rpx; }
.meal-name { color: #332f2b; font-size: 31rpx; font-weight: 750; line-height: 1.35; }
.meal-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.meal-tag { padding: 5rpx 10rpx; border-radius: 7rpx; background: #f2f0ed; color: #777068; font-size: 20rpx; }
.meal-tag.accent { background: #fff0e8; color: #b94c34; }
.meal-tag.warm { background: #fff6dc; color: #a56c14; }
.meal-meta { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.meal-price { color: var(--color-price); font-size: 28rpx; font-weight: 750; }
.meal-price.unpriced { color: #8c857e; font-size: 23rpx; font-weight: 500; }
.meal-status { color: #68845d; font-size: 21rpx; }
.total-card { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 26rpx 28rpx; border-radius: 20rpx; background: #fff; }
.total-label { color: #726b64; font-size: 25rpx; }
.total-value { color: var(--color-price); font-size: 28rpx; font-weight: 750; text-align: right; }
.total-value.unpriced { color: var(--color-text-muted); }
.bottom-space { height: 20rpx; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; flex-direction: column; gap: 14rpx; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-top: 1rpx solid #e8e3dc; background: rgba(255, 255, 255, 0.97); box-shadow: 0 -6rpx 22rpx rgba(54, 47, 40, 0.07); }
.secondary-actions { display: flex; gap: 14rpx; }
.shuffle-button, .restart-button, .accept-button { margin: 0; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; line-height: 74rpx; }
.shuffle-button, .restart-button { flex: 1; background: #f2eee9; color: #5e5650; }
.accept-button { width: 100%; background: linear-gradient(135deg, #ef6a4c, #d84c35); color: #fff; line-height: 82rpx; }
.shuffle-button::after, .restart-button::after, .accept-button::after { border: 0; }
