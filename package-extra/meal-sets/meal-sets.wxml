<view class="page">
  <view class="hero">
    <text class="eyebrow">小高の食堂</text>
    <text class="title">小高推荐套餐</text>
    <text class="subtitle">已经搭配好的组合，选规格后整套加入点菜单。</text>
  </view>
  <view wx:if="{{loading}}" class="state">正在读取套餐…</view>
  <view wx:elif="{{errorMessage}}" class="state error-state">
    <text>套餐读取失败</text>
    <text class="error-message">{{errorMessage}}</text>
    <button class="retry-button" bindtap="onRetryLoad">重新加载</button>
  </view>
  <view wx:elif="{{mealSets.length === 0}}" class="state">暂时还没有推荐套餐</view>
  <view wx:else class="set-list">
    <view wx:for="{{mealSets}}" wx:key="id" class="set-card" data-id="{{item.id}}" bindtap="goDetail">
      <image class="cover" src="{{item.displayCover}}" mode="aspectFill" data-cover="{{item.cover || item.legacyCover || item.image}}" data-src="{{item.displayCover}}" binderror="onCachedImageError" bindload="onCachedImageLoad"></image>
      <view class="card-body">
        <view class="name-row"><text class="name">{{item.name}}</text><text wx:if="{{item.recommended}}" class="recommended">小高推荐</text></view>
        <text wx:if="{{item.description}}" class="description">{{item.description}}</text>
        <view wx:if="{{item.tags.length}}" class="tags"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
        <view class="summary"><text wx:for="{{item.summaryItems}}" wx:key="*this">{{item}}</text></view>
        <view class="footer">
        <view class="footer-left"><text>共 {{item.itemCount}} 件</text><text class="total {{item.hasUnpricedItems && item.displayTotalAmount === 0 ? 'unpriced' : ''}}">{{item.displayTotalText}}</text></view>
          <text class="status {{item.canOrder ? '' : 'unavailable'}}">{{item.canOrder ? '看看这套' : '当前有商品不可点'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
