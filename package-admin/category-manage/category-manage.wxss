@import "../../styles/theme.wxss";
page { background: #F6F0E6; color: #2B2119; }
.page { min-height: 100vh; padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.header, .card-heading, .enable-row, .switch-row, .editor-actions, .card-actions { display: flex; align-items: center; }
.header { justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.title, .subtitle, .label, .tip, .meta { display: block; }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: #8a817c; font-size: 24rpx; }
.add-button, .save-button { background: var(--color-brand); color: #fff; }
.editor-card, .category-card { margin-bottom: 20rpx; padding: 26rpx; border-radius: 20rpx; background: #FFFCF7; box-shadow: 0 8rpx 24rpx rgba(60, 45, 38, 0.06); }
.editor-title { margin-bottom: 22rpx; font-size: 32rpx; font-weight: 700; }
.field { margin-bottom: 22rpx; }
.icon-upload-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.icon-preview { width: 72rpx; height: 72rpx; flex-shrink: 0; background: transparent; }
.icon-preview-empty { display: flex; align-items: center; justify-content: center; overflow: hidden; color: var(--color-text-secondary); font-size: 20rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); }
.icon-upload-button, .icon-clear-button { margin: 0; background: var(--color-brand-soft); color: var(--color-brand-dark); }
.category-list-icon { width: 48rpx; height: 48rpx; flex: 0 0 48rpx; }
.label { margin-bottom: 10rpx; font-size: 26rpx; font-weight: 600; }
.required .label::after { content: ' *'; color: #c84d3d; }
.control { min-height: 76rpx; padding: 0 22rpx; border: 1rpx solid #e4ddd8; border-radius: 14rpx; background: #fcfbfa; box-sizing: border-box; line-height: 76rpx; }
.picker { color: #332d29; }
.tip, .meta { margin-top: 10rpx; color: #8a817c; font-size: 23rpx; }
.switch-row, .enable-row { justify-content: space-between; }
.editor-actions { justify-content: flex-end; gap: 16rpx; margin-top: 26rpx; }
.editor-actions button { width: 180rpx; margin: 0; }
.card-main { margin-bottom: 18rpx; }
.card-heading { flex-wrap: wrap; gap: 12rpx; }
.category-name { font-size: 31rpx; font-weight: 700; }
.type-tag, .disabled-tag { padding: 5rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; }
.type-tag.food { background: #fff1e8; color: #b64e2f; }
.type-tag.drink { background: #eaf6ff; color: #34749c; }
.type-tag.all { background: #eef2ea; color: #59704f; }
.disabled-tag { background: #f0eeee; color: #817a76; }
.disabled-card { opacity: 0.76; }
.enable-row { padding: 12rpx 0; border-top: 1rpx solid #f0ebe8; color: #635b56; font-size: 25rpx; }
.card-actions { flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.card-actions button { margin: 0; background: #f7f3f0; color: #514944; }
.card-actions .delete-button { color: #b9493b; }
.empty { padding: 80rpx 20rpx; color: #918985; text-align: center; }
