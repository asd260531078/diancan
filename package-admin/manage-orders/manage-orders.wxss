.manage-orders-page { min-height: 100vh; padding: 24rpx 24rpx calc(100rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--color-bg); }
.filter-scroll { width: 100%; margin-bottom: 24rpx; }
.filter-row { display: inline-flex; gap: 12rpx; min-width: 100%; }
.filter-item { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; padding: 14rpx 24rpx; border-radius: 30rpx; background: #fff; color: #776f68; font-size: 23rpx; }
.filter-item.active { background: #e75c40; color: #fff; font-weight: 650; }
.filter-badge { min-width: 28rpx; height: 28rpx; padding: 0 5rpx; box-sizing: border-box; border-radius: 16rpx; background: #e95b3d; color: #fff; border: 1rpx solid #fff; font-size: 17rpx; font-weight: 700; line-height: 27rpx; text-align: center; white-space: nowrap; }
.filter-item.active .filter-badge { background: #fff; color: #e75c40; }
.state-panel, .empty-panel, .error-panel { padding: 210rpx 30rpx; color: #8e877f; text-align: center; }
.error-panel { display: flex; flex-direction: column; align-items: center; gap: 18rpx; }
.retry-button, .load-more { padding: 14rpx 28rpx; border-radius: 28rpx; background: #fff0ea; color: #c74e36; font-size: 23rpx; }
.order-list { display: flex; flex-direction: column; gap: 21rpx; }
.order-card { padding: 26rpx; border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-soft); }
.order-header { display: flex; justify-content: space-between; gap: 20rpx; align-items: flex-start; }
.order-no, .order-time { display: block; }
.order-no { color: #38332f; font-size: 27rpx; font-weight: 700; }
.order-time { margin-top: 7rpx; color: #9a938c; font-size: 21rpx; }
.status-tag { flex-shrink: 0; padding: 7rpx 16rpx; border-radius: 23rpx; font-size: 22rpx; }
.status-pending { background: #fff5df; color: #a86d13; }
.status-confirmed { background: #eaf4ff; color: #3178b7; }
.status-preparing { background: #fff0e7; color: #c35c2f; }
.status-completed { background: #eaf7ee; color: #368250; }
.status-cancelled { background: #f2f1ef; color: #817b74; }
.user-name { display: block; margin-top: 18rpx; color: #6c655e; font-size: 23rpx; }
.item-list { margin-top: 15rpx; padding: 15rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.item-line { display: block; padding: 6rpx 0; color: #49443f; font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.item-options { color: #918a83; font-size: 21rpx; }
.note-box { margin-top: 15rpx; padding: 13rpx 15rpx; border-radius: 11rpx; background: #fff8ed; color: #886630; font-size: 22rpx; line-height: 1.5; }
.card-footer { display: flex; justify-content: space-between; margin-top: 17rpx; color: #8c857d; font-size: 22rpx; }
.detail-link { color: #9a6c36; }
.load-more { align-self: center; margin: 5rpx auto 0; text-align: center; }
