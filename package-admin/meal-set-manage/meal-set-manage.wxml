<view class="page safe-bottom-page">
  <view class="header">
    <view>
      <text class="title">套餐管理</text>
      <text class="subtitle">维护小高推荐的固定搭配</text>
    </view>
    <button class="add-button" bindtap="onAdd">＋ 新建套餐</button>
  </view>

  <view wx:if="{{loading}}" class="state">正在读取套餐…</view>
  <view wx:elif="{{!isAdmin}}" class="state">当前账号无管理权限</view>
  <view wx:elif="{{mealSets.length === 0}}" class="state">还没有固定套餐</view>

  <view wx:else class="set-list">
    <view wx:for="{{mealSets}}" wx:key="id" class="set-card {{item.enabled ? '' : 'disabled'}}">
      <image class="cover" src="{{item.displayCover}}" mode="aspectFill" data-cover="{{item.cover || item.legacyCover || item.image}}" data-src="{{item.displayCover}}" binderror="onCachedImageError" bindload="onCachedImageLoad"></image>
      <view class="set-main">
        <view class="name-row">
          <text class="name">{{item.name}}</text>
          <text wx:if="{{item.recommended}}" class="tag recommended">推荐</text>
          <text wx:if="{{!item.enabled}}" class="tag off">已停用</text>
        </view>
        <text class="meta">{{item.uniqueItemCount}} 种商品 / 共 {{item.itemCount}} 件 · 排序 {{item.sort}}</text>
        <text wx:if="{{!item.canOrder}}" class="warning">含 {{item.invalidItems.length}} 项当前不可点或已失效</text>
        <view class="switch-row">
          <text>{{item.enabled ? '已启用' : '已停用'}}</text>
          <switch checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="onToggleEnabled" color="#E85B3F"></switch>
        </view>
      </view>
      <view class="actions">
        <text class="edit" data-id="{{item.id}}" bindtap="onEdit">编辑</text>
        <text class="delete" data-id="{{item.id}}" bindtap="onDelete">删除</text>
      </view>
    </view>
  </view>
</view>
