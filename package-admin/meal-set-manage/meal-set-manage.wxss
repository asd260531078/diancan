page { background: #f6f4f1; color: #332f2b; }
.page { min-height: 100vh; padding: 26rpx 24rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.title, .subtitle { display: block; }
.title { font-size: 40rpx; font-weight: 800; }
.subtitle { margin-top: 8rpx; color: #857d75; font-size: 23rpx; }
.add-button { flex-shrink: 0; margin: 0; padding: 0 22rpx; border-radius: 14rpx; background: #e45e43; color: #fff; font-size: 25rpx; line-height: 72rpx; }
.add-button::after { border: 0; }
.state { padding: 180rpx 20rpx; color: #8d857e; text-align: center; }
.set-list { display: flex; flex-direction: column; gap: 18rpx; }
.set-card { display: flex; gap: 18rpx; padding: 20rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(55, 45, 38, .05); }
.set-card.disabled { opacity: .72; }
.cover { width: 150rpx; height: 150rpx; flex-shrink: 0; border-radius: 15rpx; background: #eeeae5; }
.set-main { min-width: 0; flex: 1; }
.name-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.name { font-size: 30rpx; font-weight: 750; }
.tag { padding: 4rpx 9rpx; border-radius: 7rpx; font-size: 19rpx; }
.recommended { background: #fff1d1; color: #9b6817; }
.off { background: #eee; color: #777; }
.meta { display: block; margin-top: 12rpx; color: #777069; font-size: 22rpx; }
.warning { display: block; margin-top: 8rpx; color: #c4533d; font-size: 21rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; color: #756d66; font-size: 22rpx; }
.actions { width: 72rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; font-size: 23rpx; }
.edit { color: #b95139; }
.delete { color: #c96a5c; }
