.spec-option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.spec-option {
  min-height: 68rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfdbd5;
  border-radius: 12rpx;
  background: #f7f5f2;
  color: #554f49;
  font-size: 24rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.spec-option-active {
  border-color: #dc684d;
  background: #fff0e9;
  color: #ae432e;
  font-weight: 600;
}

.spec-option-check {
  font-weight: 800;
}

.quantity-stepper,
.compact-quantity {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  max-width: 100%;
  box-sizing: border-box;
  flex: 0 0 auto;
}

.quantity-circle,
.compact-quantity-button {
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  min-height: 60rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 60rpx;
  background: #f2efeb;
  color: #49443f;
  font-size: 30rpx;
  line-height: 1;
  text-align: center;
}

.quantity-circle::after,
.compact-quantity-button::after {
  border: 0;
}

.quantity-circle[disabled],
.compact-quantity-button[disabled] {
  background: #f5f3f0;
  color: #c1bbb4;
  opacity: 0.62;
}

.quantity-value,
.compact-quantity-value {
  width: 56rpx;
  height: 60rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3dfd9;
  border-radius: 10rpx;
  background: #fff;
  color: #49443f;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}
