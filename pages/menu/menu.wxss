/* 固定视口只负责分配空间；内容在各自 scroll-view 内滚动。 */
.page.menu-shell.tab-page-safe {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text-primary);
}
.page.menu-shell.tab-page-safe.has-cart-bar {
  /* 104rpx 点菜单条位于 TabBar 上方 120rpx；再留 32rpx 可滚动间距。 */
  padding-bottom: calc(256rpx + env(safe-area-inset-bottom));
}
.view-nav { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; height: 88rpx; }
.view-tabs { display: flex; align-items: center; gap: 32rpx; height: 100%; }
.view-tab { position: relative; height: 100%; display: flex; align-items: center; font-size: 30rpx; color: var(--color-text-secondary); transition: opacity 120ms; }
.view-tab-active { color: var(--color-text-primary); font-weight: 800; }
.view-tab-active::after { content: ''; position: absolute; bottom: 10rpx; left: 12rpx; right: 12rpx; height: 5rpx; background: var(--color-brand); border-radius: var(--radius-sm); }
.nav-note { font-size: var(--font-label); color: var(--color-text-secondary); }
.home-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.menu-shell .view-hidden { display: none; }
.menu-image-preload { position: absolute; left: -100rpx; top: -100rpx; width: 1rpx; height: 1rpx; overflow: hidden; opacity: 0; pointer-events: none; }
.menu-image-preload image { display: block; width: 1rpx; height: 1rpx; }
.home-content { padding: 0 32rpx; }
.brand-block { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; height: 224rpx; padding: 12rpx 0; box-sizing: border-box; }
.brand-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.brand-eyebrow { font-size: var(--font-label); color: var(--color-text-secondary); letter-spacing: 3rpx; }
.brand-title { font-size: var(--font-display); font-weight: 800; letter-spacing: 1.5rpx; line-height: 1.25; white-space: nowrap; }
.brand-subtitle { font-size: var(--font-body); color: var(--color-text-secondary); }
.brand-decoration { width: 240rpx; flex: 0 0 240rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; }
.section-title { font-size: var(--font-title); font-weight: 900; letter-spacing: 0.5rpx; }
.section-caption { font-size: var(--font-label); color: var(--color-text-secondary); }
.popular-list { width: 100%; }
.featured-track { display: flex; padding-bottom: 8rpx; gap: 20rpx; }
.featured-card { flex: 0 0 610rpx; width: 610rpx; max-width: 100%; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-surface); border: 1rpx solid var(--color-border); box-sizing: border-box; transition: transform 120ms, opacity 120ms; }
.featured-card-single { flex-basis: 100%; width: 100%; }
.popular-section { margin-top: 32rpx; }
.popular-track { display: flex; gap: 20rpx; padding-bottom: 8rpx; }
.popular-chip { position: relative; flex: 0 0 200rpx; width: 200rpx; border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface); border: 1rpx solid var(--color-border); box-sizing: border-box; transition: transform 120ms, opacity 120ms; }
.popular-chip-image { display: block; width: 100%; height: 150rpx; background: var(--color-surface-warm); }
.popular-chip-name { display: block; padding: 12rpx 64rpx 14rpx 16rpx; font-size: var(--font-caption); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.popular-chip-add { position: absolute; right: 10rpx; bottom: 8rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--color-brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; line-height: 1; }
.popular-chip-add.add-btn-disabled { background: var(--color-disabled); color: var(--color-text-muted); }
.featured-image { display: block; width: 100%; height: 340rpx; background: var(--color-surface-warm); }
.featured-copy { padding: 24rpx; }
.featured-heading { display: flex; align-items: baseline; gap: 16rpx; }
.featured-name { flex: 1; min-width: 0; font-size: 36rpx; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.featured-desc { display: block; font-size: var(--font-caption); color: var(--color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 10rpx; }
.featured-copy .dish-tags, .featured-copy .availability-tags { margin-top: 14rpx; }
.shortcut-grid { display: flex; padding: 28rpx 0; margin: 24rpx 0 32rpx; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.shortcut { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; transition: opacity 120ms, transform 120ms; }
.shortcut + .shortcut { border-left: 1rpx solid var(--color-border); }
.shortcut-art { display: block; width: 120rpx; height: 120rpx; flex: 0 0 120rpx; margin-bottom: 6rpx; }
.shortcut-title { font-size: var(--font-caption); font-weight: 700; white-space: nowrap; }
.shortcut-note { font-size: var(--font-label); color: var(--color-text-secondary); }
.section-link { padding: 12rpx 0 12rpx 20rpx; color: var(--color-brand-dark); font-size: var(--font-caption); }
.preview-heading { margin-bottom: 16rpx; }
.preview-list { border-radius: var(--radius-lg); padding: 0 20rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); }
.home-footnote { display: block; text-align: center; color: var(--color-text-muted); font-size: var(--font-label); padding: 36rpx 0 12rpx; letter-spacing: 2rpx; }
.menu-panel { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.search-bar { flex-shrink: 0; display: flex; align-items: center; margin: 8rpx 24rpx 24rpx; padding: 0 20rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); height: 72rpx; }
.search-symbol { flex-shrink: 0; position: relative; width: 22rpx; height: 22rpx; border: 2rpx solid var(--color-text-muted); border-radius: 50%; margin-right: 18rpx; }
.search-symbol::after { content: ''; position: absolute; width: 10rpx; height: 2rpx; background: var(--color-text-muted); transform: rotate(45deg); right: -7rpx; bottom: -3rpx; }
.search-input { flex: 1; min-width: 0; height: 72rpx; font-size: var(--font-caption); }
.search-clear { padding: 10rpx; font-size: 36rpx; color: var(--color-text-secondary); }
.menu-workspace { flex: 1; min-height: 0; display: flex; }
.category-rail { width: 156rpx; flex: 0 0 156rpx; height: 100%; background: var(--color-bg); }
.category-rail-content { padding-top: 8rpx; }
.category-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 124rpx; padding: 18rpx 14rpx; box-sizing: border-box; gap: 12rpx; color: var(--color-text-secondary); transition: background 120ms, color 120ms; }
.category-item.active { color: var(--color-brand-dark); background: var(--color-brand-soft); font-weight: 800; }
.category-item.active::before { content: ''; position: absolute; width: 5rpx; height: 36rpx; left: 0; top: 50%; margin-top: -18rpx; background: var(--color-brand); border-radius: var(--radius-sm); }
.category-pressed { background: var(--color-brand-soft); }
.category-name { width: 100%; font-size: var(--font-caption); font-weight: 600; line-height: 1.4; text-align: center; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.category-icon { width: 52rpx; height: 52rpx; flex-shrink: 0; background: transparent; }
.category-icon-text { display: block; max-width: 100%; height: 40rpx; line-height: 40rpx; font-size: 20rpx; color: var(--color-brand-dark); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.category-symbol { width: 32rpx; height: 32rpx; display: flex; flex-direction: column; justify-content: center; gap: 6rpx; opacity: 0.7; }
.category-symbol view { height: 2rpx; width: 28rpx; background: currentColor; border-radius: 2rpx; }
.menu-list-scroll { flex: 1; width: 0; min-width: 0; height: 100%; background: var(--color-surface); border-radius: var(--radius-lg) 0 0 0; }
.dish-list { padding: 0 20rpx; }
.menu-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 24rpx 0 4rpx; font-size: var(--font-body); font-weight: 700; }
.menu-list-count { flex-shrink: 0; font-size: var(--font-label); color: var(--color-text-muted); font-weight: 400; }
.dish-card { display: flex; gap: 16rpx; padding: 24rpx 0; min-height: 206rpx; box-sizing: border-box; border-bottom: 1rpx solid var(--color-border); transition: opacity 120ms, transform 120ms; }
.dish-image { width: 203rpx; height: 140rpx; flex: 0 0 203rpx; border-radius: var(--radius-md); background: var(--color-surface-warm); }
.dish-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.dish-name { font-size: 32rpx; line-height: 1.3; font-weight: 900; letter-spacing: 0.3rpx; color: var(--color-text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.dish-name-highlight { color: var(--color-brand-dark); }
.dish-desc { font-size: var(--font-caption); color: var(--color-text-secondary); line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dish-tags { display: flex; align-items: center; gap: 6rpx; flex-wrap: wrap; max-height: 68rpx; overflow: hidden; }
.dish-tag, .availability-tag { display: inline-block; font-size: var(--font-label); line-height: 1.4; padding: 2rpx 8rpx; border-radius: var(--radius-sm); white-space: nowrap; }
.signature-tag { color: #76511f; background: #f4e8c8; font-weight: 700; }
.recommended-tag { color: #b74632; background: #fbe6df; }
.new-tag { color: #276d80; background: #e2f1f3; }
.family-tag { color: #825571; background: #f3e8f0; }
.rice-tag { color: #9a5d24; background: #f8ead8; }
.spicy-tag, .custom-tag { color: var(--color-text-secondary); background: var(--color-bg); }
.sold-out-tag { color: var(--color-danger); background: var(--color-danger-soft); }
.unavailable-tag { color: var(--color-text-secondary); background: var(--color-surface-warm); }
.dish-footer { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-height: 52rpx; }
.menu-shell .price { color: var(--color-price); font-size: 34rpx; font-weight: 800; white-space: nowrap; }
.price-unset { color: var(--color-text-muted); font-size: var(--font-caption); white-space: nowrap; }
.add-btn { display: flex; align-items: center; justify-content: center; width: 52rpx; min-width: 52rpx; max-width: 52rpx; height: 52rpx; flex: 0 0 52rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--color-brand); color: #fff; line-height: 1; font-size: 36rpx; font-weight: 400; transition: transform 120ms, opacity 120ms; }
.add-btn::after { border: none; }
.menu-shell .add-btn.ui-press { background: var(--color-brand-dark); }
.menu-shell .dish-footer .add-btn { margin-left: 0; margin-right: 0; }
.menu-shell .add-btn-disabled { background: var(--color-disabled); color: var(--color-text-muted); }
.scroll-bottom-space { height: 32rpx; }
.list-more { text-align: center; padding: 24rpx 0 8rpx; font-size: var(--font-label); color: var(--color-text-muted); }

/* 购物车悬浮栏 */
.cart-bar {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 30rpx;
  right: 30rpx;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 500;
}
.cart-summary-box { position: relative; overflow: hidden; flex: 1; min-width: 0; height: 104rpx; padding: 12rpx 24rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; border-radius: var(--radius-md); background-color: #6F472D; box-shadow: none; }
.cart-summary-wood { position: absolute; z-index: 0; left: 0; top: 0; width: 100%; height: 100%; }

.cart-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-icon {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.cart-badge {
  background: var(--color-surface);
  color: var(--color-brand-dark);
  font-size: 22rpx;
  padding: 3rpx 10rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

/* 加菜后角标弹一下，代替遮挡操作的 Toast */
.cart-badge-bump { animation: cart-badge-bump 360ms ease-out; }
@keyframes cart-badge-bump {
  0% { transform: scale(1); }
  35% { transform: scale(1.45); }
  70% { transform: scale(0.92); }
  100% { transform: scale(1); }
}

.cart-total {
  position: relative;
  z-index: 1;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  white-space: nowrap;
}

.cart-bar .checkout-btn {
  background: var(--color-surface);
  color: var(--color-brand-dark);
  flex: 0 0 152rpx;
  height: 104rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: var(--shadow-soft);
}

/* 购物车弹出层 */
.cart-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001; /* 高于自定义 Tab Bar 的 z-index:1000 */
}

.cart-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.cart-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: 30rpx 30rpx 0 0;
  max-height: 70vh;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.checkout-btn-disabled {
  opacity: 0.72;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.clear-btn {
  color: var(--color-brand-dark);
  font-size: 28rpx;
}

.cart-items {
  max-height: 50vh;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.cart-item-cover {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: var(--color-surface-warm);
}

.cart-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.cart-item-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.cart-item-summary {
  max-width: 100%;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.45;
}

.cart-item-price {
  color: var(--color-price);
  font-size: 24rpx;
}

.cart-item-unpriced {
  color: var(--color-text-muted);
}

.cart-item-remove {
  color: var(--color-danger);
  font-size: 21rpx;
}

.cart-item-links {
  display: flex;
  gap: 20rpx;
}

.cart-item-edit {
  color: var(--color-brand-dark);
  font-size: 21rpx;
}

.cart-item-controls {
  display: flex;
  align-items: center;
  gap: 25rpx;
}

.cart-item-controls text {
  width: 50rpx;
  height: 50rpx;
  text-align: center;
  line-height: 50rpx;
  background: var(--color-surface-warm);
  border-radius: 50%;
  font-size: 28rpx;
}

.cart-item-controls .cart-item-quantity {
  background: transparent;
  border-radius: 0;
}

.cart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: 32rpx;
  font-weight: bold;
}

.cart-footer .checkout-btn {
  background: var(--color-brand);
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: var(--radius-md);
}

.cart-footer-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: var(--color-text-primary);
  font-size: 26rpx;
}
.cart-footer-amount { color: var(--color-price); font-weight: 700; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: var(--color-text-muted);
  font-size: 28rpx;
}
